.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Model artifacts and training data -- regenerated, not source
models/*.npz
data/*.jsonl

# Limnoria runtime bot dir (conf/logs/data/backup) -- machine-specific,
# contains secrets. NEVER remove this line.
runtime/

# Limnoria defaults to ./conf, ./logs, ./data/web relative to cwd when
# run without an explicit runtime dir (e.g. bare supybot-test/pytest from
# the repo root, which the release process's own test-suite gate does) --
# these are throwaway test artifacts, never source.
/conf/
/logs/
/data/web/
/data/backup/

.DS_Store
